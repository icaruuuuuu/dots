include=~/.config/mako/colors

## Style
font=Inter 11
width=380
height=150
margin=20
border-radius=8
padding=15

## Icons
icons=1
max-icon-size=48

## Functionality
max-history=100
sort=-time
layer=overlay
anchor=top-right
default-timeout=3000

## DND
[mode=dnd]
invisible=1

# High Urgency
[urgency=high]
default-timeout=0
