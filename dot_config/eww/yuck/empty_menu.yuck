(defwidget menu_layout []
    (box :orientation "h" :space-evenly false :spacing 5
        (box :class "card" :orientation "v" :space-evenly true :spacing 10
            (user_info)
            (media_player)
            (weather_forecast))
        (box :orientation "v" :space-evenly true
            (button_column))))


(defwidget button_column []
    (box :orientation "v" :space-evenly true :spacing 5
        (button :class "menu-btn" :cursor "pointer"
            :onclick "swaync-client -t & scripts/open-widget none"
            (label :text "")
        )
        (button :class "menu-btn" :cursor "pointer"
            :onclick "nm-connection-editor & scripts/open-widget none"
            (label :text "")
        )
        (button :class "menu-btn" :cursor "pointer"
            :onclick "blueman-manager & scripts/open-widget none"
            (label :text "")
        )
        (button :class "menu-btn" :cursor "pointer"
            :onclick "makoctl mode -t dnd"
            (label :text {mako_mode == "dnd" ? "" : ""})
        )
        (button :class "menu-btn" :cursor "pointer"
            :onclick "nautilus & scripts/open-widget none"
            (label :text "")
        )
        (button :class "invisible-btn")))

(defwidget user_info []
    (box :class "higher-card" :orientation "h" :space-evenly false
    (image :class "profile-picture"
           :path "/var/lib/AccountsService/icons/${user}"
           :image-width 70
           :image-height 70)
    (box :class "profile-info" :space-evenly false :orientation "v" :halign "center" :valign "center"
        (label :class "profile-name" :text "${user}" :halign "start")
        (label :class "profile-uname" :text "${user}@${hostname}" :halign "start")
        (label :class "profile-uptime" :text "${uptime}" :halign "start"))))

(defwidget media_player []
    (box :class "higher-card media-card" :orientation "h" :space-evenly false :spacing 12
        (box :class "media-art-container" :valign "center" :halign "center"
            (image :class "media-art-img"
                   :path {media_art != "" ? media_art : "/tmp/cover.png"}
                   :image-width 70
                   :image-height 70))
        (box :class "media-info" :orientation "v" :space-evenly false :valign "center" :spacing 2
            (label :class "media-title" 
                   :text player_title 
                   :halign "start" 
                   :limit-width 24)
            (label :class "media-artist"
                   :visible {player_artist != ""}
                   :text player_artist
                   :halign "start"
                   :limit-width 26)
            (label :class "media-status"
                   :text {player_status == "Playing" || player_status == "Paused" ? "${player_status} - ${player_pos} / ${player_length}" : player_status}
                   :halign "start"
                   :limit-width 30
                   ))))

(defwidget weather_forecast []
    (box :class "higher-card" :orientation "h" :space-evenly false :halign "start" :hexpand true
        (label :class "weather-icon" :text "${weather_data.icon}")
        (box :class "weather-info" :orientation "v" :space-evenly false :valign "center" :hexpand true
            (label :class "weather-temp" :text "${weather_data.temperature}" :halign "start")
            (label :class "weather-cond" :text "${weather_data.condition}" :halign "start"))))


