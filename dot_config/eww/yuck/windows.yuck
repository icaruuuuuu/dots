;; ~/.config/eww/yuck/windows.yuck

(defwindow close_overlay
  :monitor 0
  :geometry (geometry :width "100%"
		      :height "100%")
  :stacking "fg"
  :focusable false
  :namespace "close_overlay"
  (box
    (eventbox :onclick "scripts/open-widget none &" :class "overlay"
    (box))))

(defwindow topbar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0px"
                      :width "70%"
                      :height "24px"
                      :anchor "top center")
  :stacking "fg"
  :reserve (struts :side "top" :distance "80px")
  :focusable false
  :exclusive true
  :windowtype "dock"
  :wm-ignore false
  (topbar_layout)) 

(defwindow slider_vol
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "30px"
                      :width "300px"
                      :anchor "top center")
  :stacking "fg"
  (widget_slider_vol))

(defwindow slider_bri
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "30px"
                      :width "300px"
                      :anchor "top center")
  :stacking "fg"
  (widget_slider_bri))

(defwindow system_dashboard
  :monitor 0
  :stacking "fg"
  :geometry (geometry :x "0%" 
		      :y "30px"
		      :anchor "top center")
  (dashboard_layout))

(defwindow menu
    :monitor 0
    :stacking "fg"
    :geometry (geometry :x "15%"
                        :y "6px"
                        :width "300px"
                        :height "300px"
                        :anchor "top right")
    (menu_layout))

(defwindow power_menu
    :monitor 0
    :stacking "fg"
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "500px"
                        :height "300px"
                        :anchor "center")
    (power-menu))
