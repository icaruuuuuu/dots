;; ~/.config/eww/yuck/variables.yuck

;; Date
(defpoll date :interval "1s" "echo ' ' $(date '+%a, %d. %b %I:%M %p')")

;; Window Focus
(defvar focused_window "No focused window")

;; Workspaces
(deflisten active_workspace :initial "1" "scripts/get-workspace")

;; Sliders
(deflisten slider_data :initial '{"volume": 0, "brightness": 0}' "scripts/sliders")

;; Hardware data
(deflisten sys_metrics :initial '{"cpu": {"usage": 0, "temp": 0}, "gpu": {"usage": 0, "temp": 0}, "ram": {"used_perc": 0, "used": "0.0", "avail": "0.0", "free": "0.0"}, "disk": {"used_perc": 0, "used": "0", "total": "0"}, "uptime": "Carregando..."}' "scripts/system-info 2> /dev/null")

(defpoll sys_cpu :interval "24h" :initial "uninitialized" "scripts/hardware-info cpu")

(defpoll sys_gpu :interval "24h" :initial "uninitialized" "scripts/hardware-info gpu")

;; User data
(defpoll user :interval "24h" :initial "uninitialized" "whoami")
(defpoll hostname :interval "24h" :initial "uninitialized" "uname -n")
(defpoll uptime :interval "24h" :initial "uninitialized" "uptime -p")

;; Weather data
(defpoll weather_data :interval "30m" "scripts/get-weather")

;; Expanders
(defvar rev_bri false)
(defvar rev_vol false)

;; DND status
(deflisten mako_mode :initial "normal" "scripts/get-mako-mode")

;; Listeners for playerctl data
(defpoll media_art :interval "1s"
  "scripts/get-cover")
(deflisten player_status :initial "Idle" 
    `playerctl --follow status 2>/dev/null`)
(deflisten player_artist :initial "" 
    `playerctl --follow metadata --format '{{ artist }}' 2>/dev/null`)
(deflisten player_title  :initial "" 
    `playerctl --follow metadata --format '{{ title }}' 2>/dev/null`)
(deflisten player_pos :initial "0:00"
  `playerctl --follow position --format '{{ duration(position) }}' 2>/dev/null`)
(deflisten player_length :initial "0:00"
  `playerctl --follow metadata --format '{{ duration(mpris:length) }}' 2>/dev/null`)
