#!/bin/bash

copy-config() {
	config_dir="$1/config"
	apps_dir="$1/applications"
	echo $config_dir
	echo $HOME/.config

	mkdir -p "$HOME/.local/bin"
	mkdir -p "$HOME/.local/share/applications"

	cp -r "$config_dir/." "$HOME/.config"

	for app in $(ls $apps_dir); do
		bin=$(ls "$apps_dir/$app" | grep ".sh")
		echo $apps_dir/$app/$bin
		cp "$apps_dir/$app/$bin" "$HOME/.local/bin/$(echo $bin | cut -d '.' -f1)"

		desk=$(ls "$apps_dir/$app" | grep ".desktop")	
		cp "$apps_dir/$app/$desk" "$HOME/.local/share/applications/$desk"

	done
}
